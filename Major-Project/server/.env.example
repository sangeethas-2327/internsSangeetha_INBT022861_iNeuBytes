# CareNova Health Backend Environment Configuration Example
# Copy this file to .env and fill in your local MySQL and Server credentials

# Server Port
PORT=5000

# Client Application URL (CORS Origin)
CLIENT_ORIGIN=http://127.0.0.1:8080

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=carenova_health_db

# JWT Secret Key (For future authentication implementation in Phase 3B)
JWT_SECRET=carenova_health_demo_jwt_secret_key_2026_change_in_production
