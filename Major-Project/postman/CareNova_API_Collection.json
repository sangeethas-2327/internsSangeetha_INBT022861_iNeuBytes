{
  "info": {
    "name": "CareNova Health API - Phase 3B Auth & RBAC Collection",
    "description": "Postman API test suite for CareNova Health Healthcare Management System — Phase 3B Authentication and Role-Based Access Control (RBAC).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Health",
      "item": [
        {
          "name": "Get API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
